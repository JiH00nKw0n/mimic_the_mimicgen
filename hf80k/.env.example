# hf80k 실행 설정 본보기. `cp .env.example .env` 한 뒤 값을 채운다.
# scripts/run.sh가 이 파일을 컨테이너 안 /work/.env로 읽기 전용 마운트한다.
#
# 규칙 하나: `docker run -e`로 준 진짜 환경변수가 이 파일보다 항상 이긴다
# (docker/entrypoint.sh). GPU 4장에 컨테이너 4개를 띄울 때 공용 .env 하나를 두고
# 컨테이너마다 다른 값만 -e로 덮는 방식이 여기서 나온다.
#
# 변수 이름과 기본값은 INTERFACE.md 1절이 원본이다. 여기서 이름을 새로 만들지 않는다.

# ── 필수 두 개 ──────────────────────────────────────────────────────────────
# (필수) 허깅페이스 쓰기 토큰. 이미지에 굽지 않는다. 실행 시점에만 들어온다
HF_TOKEN=
# (필수) 올릴 저장소. 예: myorg/fr3-cube-stack-80k
HF_REPO_ID=

# ── 나머지는 기본값이 있다 ──────────────────────────────────────────────────
# 1이면 비공개 저장소로 만든다
HF_PRIVATE=1
# 만들 성공 에피소드 총 개수. 컨테이너 한 대가 책임지는 몫이다
TARGET_EPISODES=80000
# 시각 프로파일 배분. 합이 1이 되게 둔다
PROFILE_SPLIT=nominal_lab:0.50,lab_variation:0.40,stress_tail:0.10
# 청크 하나가 담는 에피소드 수. 업로드와 재개 단위이기도 하다
CHUNK_SIZE=500
# MimicGen 생성 시 동시 환경 수
NUM_ENVS=16
# 동시에 띄울 생성 프로세스 수
GEN_PROCS=1
# 동시에 띄울 렌더 프로세스 수
RENDER_PROCS=2
# 이 컨테이너가 쓸 GPU. GPU마다 컨테이너를 따로 띄운다
CUDA_VISIBLE_DEVICES=0
# 렌더 가로 픽셀
IMAGE_WIDTH=320
# 렌더 세로 픽셀
IMAGE_HEIGHT=180
# nominal, posterior_stochastic, robust_stochastic, off 중 하나
PHYSICS_PROFILE=robust_stochastic
# all이면 전체, exclude_zero_yield면 수율 0인 소스 제외, 0,1,2처럼 직접 지정도 된다
SOURCE_DEMO_FILTER=exclude_zero_yield
# MimicGen 구간 경계 오프셋. 비우면 기본값 유지
SUBTASK_OFFSETS=10,20
# 중간 파일과 청크가 쌓이는 곳. 컨테이너 밖 디스크를 여기 마운트한다
WORK_DIR=/work
# 1이면 청크 후 중간 HDF5를 지우지 않는다. 디버그용이고 청크당 수십 GB가 남는다
KEEP_INTERMEDIATE=0
# 1이면 청크마다 바로 올린다. 0이면 마지막에 merged/만 올린다
UPLOAD_EACH_CHUNK=1
# 1이면 MANIFEST.json이 done인 청크를 건너뛰고 이어서 한다
RESUME=1
# 청크마다 SEED_BASE + chunk_index를 시드로 쓴다. 컨테이너끼리 겹치면 안 된다
SEED_BASE=42000
# 이 컨테이너가 저장소에서 쓸 자기 몫의 이름. 청크는 chunks/<몫>/chunk_00000에 올라간다.
# 청크 번호는 컨테이너마다 0부터 다시 시작하므로, 몫 이름이 없으면 GPU 4장으로 돌릴 때
# 네 대가 저장소의 같은 자리를 덮어써서 4분의 1만 남는다. 비워 두면 SEED_BASE로 이름을
# 만들어 쓰므로(seed42000) 그대로 둬도 겹치지 않는다. 사람이 읽기 좋은 이름을 원하면
# gpu0처럼 직접 적는다. make run-4gpu는 gpu0부터 gpu3까지 자동으로 넣는다.
SHARD_ID=
# 로그 수준
LOG_LEVEL=INFO
# 어느 태스크로 돌릴지 고른다. src/profiles 아래의 파일 이름이다.
# cube_stack_fr3는 큐브 세 개 쌓기, peg_insert_fr3는 핀을 구멍에 꽂기다
TASK_PROFILE=cube_stack_fr3

# ── SART 증강 (선택) ────────────────────────────────────────────────────────
# SART는 성공한 궤적 한 편에서 여러 편을 만들어 내는 증강이다. 정밀 구간 바로 앞의 손
# 자세 주변에서 자세를 하나 뽑아 거기서 원래 자세로 되돌아오게 만들고, 앞뒤 구간은
# 원본을 그대로 재생한다. 생성과 변환 사이에 한 단계로 들어간다.
#
# 돌릴지 여부. 비우면 태스크 프로필이 정한다. 핀 삽입은 켜지고 큐브 쌓기는 꺼진다.
# 0으로 두면 어떤 태스크에서도 꺼진다
SART_ENABLE=
# 동시에 띄울 증강 프로세스 수
SART_PROCS=1
# 소스 에피소드 한 편당 증강을 몇 번 시도할지. 비우면 태스크 프로필의 값을 쓴다
SART_SAMPLES=
# 접근 자세를 뽑는 공의 반지름, 미터. 비우면 태스크 프로필의 값을 쓴다
SART_RADIUS_M=
# 청크 할당량 중 MimicGen에 요청할 비율. 비우면 태스크 프로필의 값을 쓴다.
# 1.0으로 두면 생성이 할당량을 다 만들고 증강분이 그 위에 더해져 청크가 커진다.
# 증강 성공률을 처음 재 볼 때 1.0으로 두면 잃을 것이 없다
SART_SOURCE_FRAC=

# 참고: 컨테이너 안에는 이미지가 심어둔 값이 몇 개 더 있다. 건드릴 일은 없다.
#   HF80K_SRC=/opt/hf80k/src           파이프라인 코드
#   HF80K_ASSETS=/opt/hf80k/assets     소스 시연, 캘리브레이션 번들, 시각 랜덤화 패키지
#   HF80K_LEROBOT_PATH=...             lerobot/huggingface_hub 격리 설치 위치.
#                                      기록·업로드 단계에서만 PYTHONPATH에 올린다
#   LAB_TABLE_USD=...                  시각 랜덤화 패키지 안의 실험실 책상 USD

# ────────────────────────────────────────────────────────────────────────────
# 연기 시험 100편 (GPU 한 장, 약 한 시간)
#
# 아래 설정으로 실제로 돌려 100편이 40분 걸렸다. 편당 23.0초다(생성 11.6초, 변환
# 1.4초, 렌더 5.6초, 기록 4.3초, 업로드 0.07초). 청크를 50으로 줄여 청크 경계와
# 업로드와 재개 경로를 두 번 지나가게 한다.
#
#   HF_REPO_ID=myorg/fr3-cube-stack-smoke
#   TARGET_EPISODES=100
#   CHUNK_SIZE=50
#   NUM_ENVS=16
#   GEN_PROCS=1
#   RENDER_PROCS=2
#   UPLOAD_EACH_CHUNK=1
#   SEED_BASE=1000
#   LOG_LEVEL=DEBUG
#
# 확인할 것: 청크 세 개의 MANIFEST.json이 전부 done인지, yield가 0.12 근처인지,
# 저장소에 영상 3종과 parquet이 올라갔는지.

# ────────────────────────────────────────────────────────────────────────────
# 8만 편 프로덕션: GPU 4장 박스에 컨테이너 4개, 한 대당 2만 편
#
# 공용 값은 이 .env에 그대로 두고, 컨테이너마다 다른 것만 -e로 덮는다.
# 세 가지가 반드시 서로 달라야 한다. 호스트 WORK_DIR이 같으면 네 컨테이너가 같은 청크
# 디렉터리를 두고 싸운다. SEED_BASE가 같으면 같은 데모를 네 벌 만든다. SHARD_ID가 같으면
# 저장소의 같은 자리에 올려 서로 덮어써서 8만 편이 아니라 2만 편만 남는다.
# make run-4gpu는 셋을 모두 자동으로 다르게 넣는다.
#
#   HF_REPO_ID=myorg/fr3-cube-stack-80k
#   CHUNK_SIZE=500
#   NUM_ENVS=16
#   GEN_PROCS=1
#   RENDER_PROCS=2
#   UPLOAD_EACH_CHUNK=1
#   RESUME=1
#
#   컨테이너  GPU  TARGET_EPISODES  SEED_BASE  SHARD_ID  호스트 WORK_DIR
#   gpu0      0    20000            42000      gpu0      /data/hf80k/gpu0
#   gpu1      1    20000            52000      gpu1      /data/hf80k/gpu1
#   gpu2      2    20000            62000      gpu2      /data/hf80k/gpu2
#   gpu3      3    20000            72000      gpu3      /data/hf80k/gpu3
#   합계           80000
#
# 다 끝나면 네 대분을 한 번에 합친다. 작업 디렉터리를 전부 넘겨야 한다.
#   make aggregate WORK='/data/hf80k/gpu*'
# 하나만 넘기면 2만 편짜리 데이터셋이 조용히 만들어진다.
#
# 시드 간격 10000은 넉넉하다. 한 대가 도는 청크는 20000/500 = 40개뿐이라
# 실제로 쓰는 시드는 SEED_BASE부터 40개다.
#
# 예상 시간: 실측 편당 23.0초 × 20000편 = 약 128시간(5.3일). 네 대가 동시에 도니
# 벽시계로도 5.3일이다. 이 값은 50편 청크에서 잰 것이라 Isaac 시작 비용이 편당 크게
# 잡혀 있다. 500편 청크에서는 그만큼 줄어든다.
#
# 띄우는 방법은 make run-4gpu 한 줄이다.

# --- 보통은 건드리지 않는 값 ------------------------------------------------
# 로봇 받침의 스폰 회전. 기본값이 실기와 같은 방향이다. 0,0,0,1로 두면 로봇이 180도
# 반대를 보며 수율이 절반이 되고 실측 카메라가 작업면에서 약 1 m 빗나간다.
LAB_ROBOT_SPAWN_ROT=0,0,1,0
# 물리 캘리브레이션 번들 위치. 이미지 안 기본 경로를 쓰면 비워 둔다.
# LAB_SYSID_BUNDLE_ROOT=/opt/hf80k/assets/fr3_cube_system_calibration_bundle_v1
# lerobot 격리 설치 경로. 이미지가 정해 두므로 보통 비워 둔다.
# LEROBOT_SITE=/opt/hf80k/deps/lerobot_0_4_py311
# 성공 판정 임계값. 마지막 순간 큐브 속도 상한(m/s)과 그리퍼가 열렸다고 볼 값(m).
# LAB_SUCCESS_REST_SPEED=0.02
# LAB_SUCCESS_GRIPPER_OPEN=0.03
